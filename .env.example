# Server
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false

# Authentication — generate a long random secret for deployment
JWT_SECRET=replace-with-a-long-random-secret

# Application-level encryption for medical profile fields.
# Use a long random value in deployment.
ENCRYPTION_KEY=replace-with-a-long-random-secret

# MongoDB Atlas (required for persistent cloud data)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/resqverse

# Gemini — kept server-side only; never put this in index.html
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

